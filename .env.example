# Copia este archivo a ".env" y rellena tu clave de API.
#
# Por defecto la app usa la API GRATUITA de Google Gemini.
# Consigue tu clave (gratis, con tu cuenta de Google) en:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de Gemini a usar (opcional, el valor por defecto ya es adecuado)
GEMINI_MODEL=gemini-3.6-flash

# Qué proveedor de IA usar: "gemini" (gratuito, por defecto) o "anthropic" (de pago)
AI_PROVIDER=gemini

# Alternativa de pago: clave de API de Anthropic (Claude), solo si prefieres usarla
# en vez de Gemini. Se obtiene en https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Clave secreta de Flask (cualquier cadena aleatoria, solo para sesiones locales)
FLASK_SECRET_KEY=cambia-esto-por-una-cadena-aleatoria
